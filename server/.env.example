# 없으면 규칙 기반 파서로 동작 (기본 문장은 키 없이도 기록됨)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# auto(키 있으면 OpenAI) | rules | openai
PARSER=auto
# 비워두면 start_server 실행 시 자동 생성됩니다. 앱 설정 화면에 같은 값을 입력
BABYMIND_TOKEN=
TIMEZONE=Asia/Seoul
# DB_PATH=./babymind.db
PORT=8000
# 1로 바꾸면 Bixby용 공개 HTTPS 주소(Cloudflare 임시 터널)를 자동으로 만듭니다
TUNNEL=0
# 주소가 바뀌지 않는 고정 터널을 쓰려면 Cloudflare에서 발급한 토큰과 그 주소
CLOUDFLARE_TUNNEL_TOKEN=
PUBLIC_URL=
